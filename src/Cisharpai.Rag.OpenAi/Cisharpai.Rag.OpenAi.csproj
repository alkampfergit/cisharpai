<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Bridge package connecting Cisharpai.OpenAi hosted retrieval (file_search) with Cisharpai.Rag's IRetriever contract.</Description>
    <PackageTags>rag;openai;file-search;retrieval;llm;ai</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cisharpai.OpenAi\Cisharpai.OpenAi.csproj" />
    <ProjectReference Include="..\Cisharpai.Rag\Cisharpai.Rag.csproj" />
  </ItemGroup>
</Project>
